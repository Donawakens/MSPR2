[all:vars]
ansible_user=ansible
ansible_ssh_private_key_file=~/MSPR2/Common/ansible_key
ansible_ssh_extra_args=-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null

[admin]
ADMIN-SRV-2 ansible_host=${admin_ip}

[nextcloud]
FILE-SRV-2 ansible_host=${nextcloud_replicas_ip}

[firewall]
FW-MCO-1 ansible_host=${firewall_wan_ip}

[firewall:vars]
firewall_vlan20_ip=${firewall_vlan20_ip}
firewall_vlan21_ip=${firewall_vlan21_ip}


[linux:children]
admin
nextcloud
firewall