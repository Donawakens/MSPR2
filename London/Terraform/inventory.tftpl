[all:vars]
ansible_user=ansible
ansible_ssh_private_key_file=~/MSPR2/Common/ansible_key
ansible_ssh_extra_args='-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null'

[admin]
ADMIN-SRV-1 ansible_host=${admin_ip}

# --- Groupes Sync-In ---
[syncin_london]
FILE-SRV-1 ansible_host=${syncin_ip}

[syncin_dc]
FILE-SRV-3 ansible_host=${syncin_datacenter_ip}

[syncin:children]
syncin_london
syncin_dc

[supervision]
SUP-SRV-1 ansible_host=${supervision_ip}

# --- Groupes Firewall ---
[firewall_london]
FW-LDN-1 ansible_host=${firewall_wan_ip}

[firewall_dc]
FW-DC-1 ansible_host=${firewall_datacenter_wan_ip}

[firewall_aus]
FW-AUST-1 ansible_host=${firewall_australie_wan_ip}

[firewall:children]
firewall_london
firewall_dc
firewall_aus

[firewall:vars]
firewall_vlan10_ip=${firewall_vlan10_ip}
firewall_vlan11_ip=${firewall_vlan11_ip}
firewall_vlan30_ip=${firewall_vlan30_ip}
firewall_vlan50_ip=${firewall_vlan50_ip}

[linux:children]
admin
syncin
supervision
firewall

[windows]
WIN-SRV-1 ansible_host=${active_directory_ip}
BV-SRV-1  ansible_host=${bureau_virtuel_ip}

[windows:vars]
ansible_user=ansible
ansible_password=Adminadmin1234
ansible_connection=winrm
ansible_port=5986
ansible_winrm_scheme=https
ansible_winrm_server_cert_validation=ignore
ansible_winrm_transport=basic